# Copy to config.yaml and fill in your values
admin_phone: "5511999999999"
persona_dir: "persona/"
session_storage_dir: "sessions/"
poll_interval: 5.0
response_mode: "whitelist"          # all | admin_only | whitelist
whitelist:                     # phone numbers or group JIDs for whitelist mode
  # - "5522888888888"
  # - "120363001234567890@g.us"
log_level: "INFO"
log_file: "agent.log"

#mcp_servers:
#  - name: "filesystem"
#    transport: "stdio"
#    command: "npx"
#    args: ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]
#    role: "admin"

# Omit model to retain the original Bedrock provider.
# OpenAI requires OPENAI_API_KEY in the environment or local .env.
model:
  provider: openai                 # openai | anthropic | bedrock
  model_id: gpt-4.1-mini           # choose a tool-capable model available to your account
  max_tokens: 2048
  # base_url: https://api.openai.com/v1
# Anthropic: provider: anthropic, your Claude model ID, and ANTHROPIC_API_KEY.
# Optional base_url must speak the selected provider's API, including streaming/tool calls.
